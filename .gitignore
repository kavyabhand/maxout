__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# data (large, regenerated via janus.data.download, never commit raw datasets)
data/raw/
data/*.csv
data/*.parquet
*.zip
# data/processed/ is INTENTIONALLY tracked: it holds only small (KB-scale) computed
# result JSONs (see janus/orchestrate/persist.py), never raw rows, so the repo/prototype
# shows real results out of the box instead of every screen reading "not yet computed."

# secrets
.env
*.pem
kaggle.json

# model artifacts (large binaries, regenerate via janus.defend.nlp.train_distilbert etc.)
*.pt
*.pth
*.ckpt
*.safetensors
models/*
!models/README.md

# frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.production

# deployment scratch
.deploy/
# Vercel's local project link (org/project ids), regenerated by `vercel link`
.vercel/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# scratch
.tmp_*
