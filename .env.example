# Copy to .env and fill in. .env is gitignored, never commit real keys.
#
# Nothing here is required. JANUS runs fully offline with zero credentials
# by default (JANUS_LLM_BACKEND=scripted), see README.md.

# Optional. Only used by the "openai" LLM backend (live, adaptive red-team /
# shopping-agent / Identify Agent generation). Omit to stay on the scripted
# or local backend.
OPENAI_API_KEY=sk-proj-...

# Optional. Selects the agentic LLM backend: "openai" | "local" | "scripted".
# Defaults to "openai" if OPENAI_API_KEY is set, else "scripted".
JANUS_LLM_BACKEND=scripted

# Optional. HuggingFace model id used by the "local" backend (downloaded
# credential-free from the HF Hub, run on CPU). Defaults to a small
# instruct model, see janus/common/llm.py.
JANUS_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional. Override where datasets/model checkpoints are read/written.
# Default: <repo root>/data and <repo root>/models.
JANUS_DATA_DIR=./data
JANUS_MODELS_DIR=./models
